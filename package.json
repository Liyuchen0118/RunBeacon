{
  "name": "console-automation-mcp",
  "version": "3.0.0",
  "description": "Durable task lifecycle, SSH Runner, CLI, MCP server, GitHub publishing, and credentials for AI agents",
  "mcpName": "io.github.liyuchen0118/runbeacon",
  "main": "dist/mcp/lifecycle-server.js",
  "type": "module",
  "bin": {
    "console-automation-mcp": "./dist/mcp/lifecycle-server.js",
    "remote-job-monitor": "./dist/mcp/lifecycle-server.js",
    "runbeacon": "./dist/cli/runbeacon.js"
  },
  "scripts": {
    "clean:dist": "node scripts/clean-dist.mjs",
    "build": "node scripts/clean-dist.mjs && tsc",
    "dev": "tsx src/mcp/lifecycle-server.ts",
    "dev:lifecycle": "tsx src/mcp/lifecycle-server.ts",
    "start": "node dist/mcp/lifecycle-server.js",
    "start:lifecycle": "node dist/mcp/lifecycle-server.js",
    "start:persistent": "node dist/mcp/lifecycle-server.js",
    "test": "jest --config jest.runbeacon.config.cjs --runInBand",
    "test:unit": "jest --config jest.runbeacon.config.cjs --runInBand",
    "test:stress:smoke": "node scripts/stress-smoke-test.mjs",
    "test:all": "jest --config jest.runbeacon.config.cjs --runInBand",
    "test:ssh:smoke": "node scripts/ssh-smoke-test.mjs",
    "test:watch": "jest --config jest.runbeacon.config.cjs --watch",
    "test:coverage": "jest --config jest.runbeacon.config.cjs --coverage",
    "test:ci": "jest --config jest.runbeacon.config.cjs --ci --coverage --maxWorkers=2",
    "test:lifecycle:mcp": "node scripts/lifecycle-mcp-smoke-test.mjs",
    "test:lifecycle:daemon": "node scripts/lifecycle-daemon-smoke-test.mjs",
    "test:github-publish": "node scripts/github-publish-runner-smoke-test.mjs",
    "test:security:performance": "node --expose-gc scripts/security-performance-test.mjs",
    "test:installer": "node scripts/installer-smoke-test.mjs && node scripts/runner-installer-security-test.mjs",
    "test:package": "node scripts/package-smoke-test.mjs",
    "lint": "eslint src/lifecycle src/daemon/lifecycle-daemon.ts src/daemon/github-publish-runner.ts src/mcp/lifecycle-server.ts src/cli --ext .ts --max-warnings 0",
    "format": "prettier --write \"src/{lifecycle,daemon,mcp,cli}/**/*.{ts,js,json}\" \"src/tests/{CredentialProfileStore,GitCredentialManager,GitHubActionsMonitor,GitHubApiClient,GitHubPublish,GitHubWorkflowEligibility,LifecycleManager,PluginHooks,RunBeaconV3Security,SshPasswordProfileManager}.test.ts\"",
    "format:check": "prettier --check \"src/{lifecycle,daemon,mcp,cli}/**/*.{ts,js,json}\" \"src/tests/{CredentialProfileStore,GitCredentialManager,GitHubActionsMonitor,GitHubApiClient,GitHubPublish,GitHubWorkflowEligibility,LifecycleManager,PluginHooks,RunBeaconV3Security,SshPasswordProfileManager}.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "test:runner": "cd runner && go test -race ./...",
    "test:release-evidence": "node scripts/release-evidence-test.mjs && node scripts/codex-exec-json-test.mjs && node scripts/codex-command-test.mjs"
  },
  "keywords": [
    "mcp",
    "ssh",
    "runner",
    "jobs",
    "lifecycle",
    "ai-agent",
    "llm"
  ],
  "author": "RunBeacon contributors",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "minimatch": "^9.0.9",
    "re2js": "2.8.6",
    "ssh2": "^1.17.0",
    "undici": "^6.28.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.8"
    },
    "express-rate-limit": "^8.5.2",
    "ip-address": "^10.2.0",
    "protobufjs": "^7.6.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liyuchen0118/RunBeacon.git"
  },
  "bugs": {
    "url": "https://github.com/Liyuchen0118/RunBeacon/issues"
  },
  "homepage": "https://github.com/Liyuchen0118/RunBeacon#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist/lifecycle",
    "dist/daemon/lifecycle-daemon.js",
    "dist/daemon/lifecycle-daemon.js.map",
    "dist/daemon/github-publish-runner.js",
    "dist/daemon/github-publish-runner.js.map",
    "dist/mcp/lifecycle-server.js",
    "dist/mcp/lifecycle-server.js.map",
    "dist/cli",
    ".codex-plugin",
    ".mcp.json",
    "hooks",
    "skills",
    "README.md",
    "LICENSE"
  ]
}
