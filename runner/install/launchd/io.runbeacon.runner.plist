<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.runbeacon.runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>__RUNNER_PATH__</string>
    <string>serve</string>
  </array>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/runner.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/runner.stderr.log</string>
</dict>
</plist>
