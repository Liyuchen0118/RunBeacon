{
  "description": "Select RunBeacon by default, attach prompt timing to tracked jobs, and prevent untracked raw SSH commands.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/route-remote-prompt.cjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\route-remote-prompt.cjs\"",
            "timeout": 5,
            "statusMessage": "Selecting tracked remote execution"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__(?:runbeacon|remote[-_]job[-_]monitor)__job_start$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/inject-job-trace.cjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\inject-job-trace.cjs\"",
            "timeout": 5,
            "statusMessage": "Attaching RunBeacon request timing"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/route-ssh.cjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\route-ssh.cjs\"",
            "timeout": 5,
            "statusMessage": "Checking SSH job routing"
          }
        ]
      }
    ]
  }
}
